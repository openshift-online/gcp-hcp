# TEMPORARY, ADDITIVE migration-parity exception (not least privilege).
#
# This grants the Argo CD application controller the same wildcard
# permissions as the legacy bootstrap controller, in ADDITION to the
# ClusterRole/ClusterRoleBinding the operator generates itself (for the
# reviewed seed argocd/gitops: gitops-argocd-argocd-application-controller,
# bound to the same ServiceAccount; Kubernetes RBAC is additive, so the
# effective permissions are the union). It is kept because the operator-
# generated role is not migration-parity-equivalent: the pinned GitOps
# operator registers its OpenShift ReconcilerHook unconditionally, which
# replaces the stock wildcard rules with narrower ones (cluster-wide read,
# writes limited to rbac/storage-style cluster resources and a few core
# kinds, serviceaccount impersonation). Dropping this grant would lose
# writes to workload kinds (Deployment, Service, Secret, ...) in namespaces
# the operator does not manage, and cluster writes such as CRDs and webhooks,
# that the legacy controller performs today. Pinned-source evidence only
# (see tools/gitops-bootstrap/chart-src/PROVENANCE.md), not GKE runtime proof.
#
# Exit criterion: GCP-1285 supplies and validates scoped permissions that
# cover the managed workloads; only then may this grant be removed or narrowed.
# Until then it must not be copied as a pattern. Named distinctly so it cannot
# collide with any operator-generated or legacy role. The subject ServiceAccount
# follows the operator's <instance>-argocd-application-controller naming
# (pinned source; on-cluster confirmation is later runtime work).
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: __INSTANCE_NAME__-application-controller-interim-parity
  labels:
    app.kubernetes.io/part-of: gke-bootstrap
    gke-bootstrap/target-type: __TARGET_TYPE__
rules:
  - apiGroups: ["*"]
    resources: ["*"]
    verbs: ["*"]
  - nonResourceURLs: ["*"]
    verbs: ["*"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: __INSTANCE_NAME__-application-controller-interim-parity
  labels:
    app.kubernetes.io/part-of: gke-bootstrap
    gke-bootstrap/target-type: __TARGET_TYPE__
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: __INSTANCE_NAME__-application-controller-interim-parity
subjects:
  - kind: ServiceAccount
    name: __INSTANCE_NAME__-argocd-application-controller
    namespace: __INSTANCE_NAMESPACE__
