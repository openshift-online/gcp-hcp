# INTERIM parity RBAC: mirrors the wildcard permissions of the existing
# application controller until scoped permissions are reviewed. Named
# distinctly so it cannot be confused with, or collide with, any
# operator-generated or legacy role. Subject ServiceAccount follows the
# operator's <instance>-argocd-application-controller naming (verified from
# operator source; on-cluster confirmation is later runtime work).
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: __INSTANCE_NAME__-application-controller-interim-parity
  labels:
    app.kubernetes.io/part-of: gke-bootstrap
    gke-bootstrap/target-type: __TARGET_TYPE__
rules:
  - apiGroups: ["*"]
    resources: ["*"]
    verbs: ["*"]
  - nonResourceURLs: ["*"]
    verbs: ["*"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: __INSTANCE_NAME__-application-controller-interim-parity
  labels:
    app.kubernetes.io/part-of: gke-bootstrap
    gke-bootstrap/target-type: __TARGET_TYPE__
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: __INSTANCE_NAME__-application-controller-interim-parity
subjects:
  - kind: ServiceAccount
    name: __INSTANCE_NAME__-argocd-application-controller
    namespace: __INSTANCE_NAMESPACE__
