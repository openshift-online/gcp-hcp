apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
# Inactive bundle: nothing references this directory yet. The three shared
# Application/ApplicationSet/AppProject CRDs and the argocd namespace, ESO and
# bootstrap stores are owned by the parent and are NOT declared here.
resources:
  - crds.yaml
  - operator.yaml
  - registry.yaml
  - networkpolicy.yaml
  - gitops-instance.yaml
  - controller-rbac.yaml
patches:
  # ControllerConfiguration is a required dependency API: the operator's
  # ArgoCD reconcile reads it even with Promoter disabled. It is declared by
  # this (sole MC/region) child like every other child CRD and is normally
  # mutation-managed, so the manager and the ArgoCD seed may depend on it
  # (a mutation:ignore target would make Config Sync skip its dependents on
  # every sync after the first). Only deletion:detach is added, so dropping the
  # declaration never deletes the schema. Retiring the child stays a separately
  # reviewed, destructive step (see bootstrap-gitops/README.md).
  - target:
      group: apiextensions.k8s.io
      version: v1
      kind: CustomResourceDefinition
      name: controllerconfigurations.promoter.argoproj.io
    patch: |-
      apiVersion: apiextensions.k8s.io/v1
      kind: CustomResourceDefinition
      metadata:
        name: controllerconfigurations.promoter.argoproj.io
        annotations:
          client.lifecycle.config.k8s.io/deletion: detach
  # The manager's controllers need these APIs and the pull secret to exist.
  - target:
      group: apps
      version: v1
      kind: Deployment
      name: openshift-gitops-operator-controller-manager
      namespace: __OPERATOR_NAMESPACE__
    patch: |-
      apiVersion: apps/v1
      kind: Deployment
      metadata:
        name: openshift-gitops-operator-controller-manager
        namespace: __OPERATOR_NAMESPACE__
        annotations:
          config.kubernetes.io/depends-on: __MANAGER_DEPENDS_ON__
