{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "dependencyDashboard": true,
  "dependencyDashboardOSVVulnerabilitySummary": "none",
  "automerge": false,
  "addLabels": ["ok-to-test", "area/dependency"],
  "prConcurrentLimit": 10,
  "semanticCommits": "enabled",
  "gomod": {
    "postUpdateOptions": ["gomodTidyAll", "gomodUpdateImportPaths"],
    "packageRules": [
      {
        "matchPackageNames": ["golang.org/x/**"],
        "groupName": "golang.org/x packages",
        "groupSlug": "golang-org-x"
      },
      {
        "matchPackageNames": [
          "k8s.io/**",
          "/^sigs\\.k8s\\.io/controller-runtime/",
          "sigs.k8s.io/controller-tools"
        ],
        "groupName": "Kubernetes packages",
        "groupSlug": "kubernetes"
      },
      {
        "matchPackageNames": ["github.com/onsi/**"],
        "groupName": "Onsi packages",
        "groupSlug": "onsi"
      },
      {
        "matchManagers": ["gomod"],
        "matchUpdateTypes": ["major"],
        "enabled": false
      }
    ]
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["registry.access.redhat.com/ubi9/go-toolset"],
      "allowedVersions": "/^1\\./"
    }
  ]
}
