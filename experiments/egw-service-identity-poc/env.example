# EGW Service Identity POC - Environment Configuration
#
# Instructions:
#   1. Copy this file: cp env.example .env
#   2. Edit .env with your actual values
#   3. Run the scripts in order: ./1-setup-gcp.sh, ./2-run-keycloak.sh, ...
#
# Note: .env is gitignored and won't be committed

# ============================================================================
# REQUIRED SETTINGS
# ============================================================================

# GCP project for the throwaway signer service account
export POC_PROJECT_ID="cveiga-gcp-hcp-1"

# ============================================================================
# OPTIONAL SETTINGS
# ============================================================================

# Name of the throwaway signer service account
# export POC_SA_NAME="egw-poc-signer"

# Container runtime (default: podman, falls back to docker)
# export POC_CONTAINER_ENGINE="podman"

# Keycloak image
# export POC_KEYCLOAK_IMAGE="quay.io/keycloak/keycloak:26.8"

# Keycloak port on localhost (change if 8080 is taken)
# export POC_KEYCLOAK_PORT="8080"

# JWKS refetch proxy port on localhost
# export POC_PROXY_PORT="9099"

# ============================================================================
# VERIFICATION
# ============================================================================
# After sourcing this file, verify with:
#   echo "Project: $POC_PROJECT_ID"
